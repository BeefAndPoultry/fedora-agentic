[Unit]
Description=llama.cpp Router Inference Server
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/llama-cpp/models.ini

[Service]
Type=simple
DynamicUser=yes
StateDirectory=llama-cpp
ConfigurationDirectory=llama-cpp
EnvironmentFile=-/etc/sysconfig/llama-server
ExecStart=/usr/bin/llama-server --models-preset ${LLAMA_PRESET} --host ${LLAMA_HOST} --port ${LLAMA_PORT} ${LLAMA_ARGS}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
