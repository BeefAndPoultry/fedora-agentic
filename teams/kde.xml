<image>
	<profiles>
		<profile name="KDE-Desktop-Live" description="KDE Plasma Desktop Spin Live DVD">
			<requires profile="KDE-Desktop"/>
			<requires profile="LiveInstall"/>
		</profile>
		<profile name="KDE-Desktop-Disk" description="KDE Plasma Desktop Spin Install Disk">
			<requires profile="BootDiskCore"/>
			<requires profile="KDE-Desktop"/>
		</profile>
		<profile name="KDE-Mobile-Live" description="KDE Plasma Mobile Spin Live DVD">
			<requires profile="KDE-Mobile"/>
			<requires profile="LiveInstall"/>
		</profile>
		<profile name="KDE-Mobile-Disk" description="KDE Plasma Mobile Spin Install Disk">
			<requires profile="BootDiskCore"/>
			<requires profile="KDE-Mobile"/>
		</profile>
	</profiles>
	<packages type="bootstrap" profiles="KDE-Desktop-Disk,KDE-Desktop-Live">
		<package name="fedora-release-kde"/>
	</packages>
	<packages type="bootstrap" profiles="KDE-Mobile-Disk,KDE-Mobile-Live">
		<package name="fedora-release-kde-mobile"/>
	</packages>
	<packages type="image" profiles="KDE-Desktop-Disk,KDE-Desktop-Live">
		<!-- Plasma Welcome app is optional for a live ISO; drop it to help keep
		     the ISO under GitHub's 2 GB release cap (fix #24 / PR #27). Reinstallable
		     later via `dnf install plasma-welcome-fedora`. -->
		<ignore name="plasma-welcome-fedora"/>
		<!-- <package name="plasma-welcome-fedora"/> -->
		<!-- Cut the Fedora Workstation/Desktop weak-dependency stack that
		     DesktopCommon (@plusRecommended) and LiveInstall pull in for the
		     KDE spin, so the live ISO stays under GitHub's 2 GB cap. In KIWI a
		     <ignore> is global — it removes the package from the whole
		     transaction regardless of which profile drags it in (Recommends:
		     or otherwise), so listing these here trims them everywhere yet
		     keeps firefox, mesa-vulkan-drivers and llama-cpp intact. Sizes are
		     approximate uncompressed MB from the build's top-30 report. -->
		<ignore name="libreoffice-core"/>              <!-- 289.1 MB -->
		<ignore name="libreoffice-data"/>
		<ignore name="libreoffice-help-en"/>           <!-- 51.2 MB -->
		<ignore name="java-25-openjdk-headless"/>      <!-- 237.0 MB (pulled by libreoffice) -->
		<ignore name="glibc-all-langpacks"/>           <!-- 227.2 MB (en_US + glibc-minimal-langpack remain) -->
		<ignore name="ibus"/>                          <!-- 147.4 MB (Wayland virtual keyboard / fcitx5 if installed later) -->
		<ignore name="python3-botocore"/>              <!-- 119.9 MB (AWS SDK from anaconda cloud plugins) -->
		<ignore name="cldr-emoji-annotation"/>         <!-- 119.0 MB -->
		<ignore name="nvidia-gpu-firmware"/>           <!-- 101.0 MB -->
		<ignore name="mariadb-server"/>                <!-- 80.4 MB (akonadi embedded db) -->
		<ignore name="mariadb-common"/>
		<ignore name="akonadi-server"/>
		<ignore name="google-noto-serif-cjk-vf-fonts"/><!-- 54.8 MB -->
		<ignore name="google-noto-sans-cjk-vf-fonts"/>
		<ignore name="podman"/>                        <!-- 52.7 MB -->
		<ignore name="firefox-langpacks"/>             <!-- 48.8 MB (English Firefox works without extras) -->
		<ignore name="vlc-libs"/>                      <!-- 43.3 MB -->
	</packages>
</image>
