<image>
	<profiles>
		<profile name="KDE-Desktop-Live" description="KDE Plasma Desktop Spin Live DVD">
			<requires profile="KDE-Desktop"/>
			<requires profile="LiveInstall"/>
		</profile>
		<profile name="KDE-Desktop-Disk" description="KDE Plasma Desktop Spin Install Disk">
			<requires profile="BootDiskCore"/>
			<requires profile="KDE-Desktop"/>
		</profile>
		<profile name="KDE-Mobile-Live" description="KDE Plasma Mobile Spin Live DVD">
			<requires profile="KDE-Mobile"/>
			<requires profile="LiveInstall"/>
		</profile>
		<profile name="KDE-Mobile-Disk" description="KDE Plasma Mobile Spin Install Disk">
			<requires profile="BootDiskCore"/>
			<requires profile="KDE-Mobile"/>
		</profile>
	</profiles>
	<packages type="bootstrap" patternType="onlyRequired" profiles="KDE-Desktop-Disk,KDE-Desktop-Live">
		<package name="fedora-release-kde"/>
	</packages>
	<packages type="bootstrap" patternType="onlyRequired" profiles="KDE-Mobile-Disk,KDE-Mobile-Live">
		<package name="fedora-release-kde-mobile"/>
	</packages>
	<packages type="image" patternType="onlyRequired" profiles="KDE-Desktop-Disk,KDE-Desktop-Live">
		<!-- Leaf consumers of the bases we ignore above (libreoffice-data, akonadi-server,
			 ibus, vlc-libs, podman). The kde-desktop-environment env-group and DesktopCommon's
			 plusRecommended still RECOMMEND these leaf packages; each one hard-Requires a base
			 we've dropped, so leaving them in produced unsatisfiable dependencies and failed the
			 build (problems 1-18 from DNF5). Ignoring the leaves is the root-cause fix rather
			 than cascade-ignoring — drop the consumer, not the base, so the transaction stays
			 satisfiable. Reinstallable via dnf later. -->
		<!-- <ignore name="libreoffice-writer"/>
		<ignore name="libreoffice-calc"/>
		<ignore name="libreoffice-impress"/>
		<ignore name="libreoffice-graphicfilter"/>
		<ignore name="libreoffice-emailmerge"/>
		<ignore name="libreoffice-pyuno"/>
		<ignore name="akonadi-server-mysql"/>
		<ignore name="korganizer"/>
		<ignore name="kaddressbook"/>
		<ignore name="kleopatra"/>
		<ignore name="vlc-plugin-gstreamer"/>
		<ignore name="phonon-qt6-backend-vlc"/>
		<ignore name="toolbox"/>
		<ignore name="ibus-typing-booster"/>
		<ignore name="ibus-m17n"/>
		<ignore name="ibus-libpinyin"/>
		<ignore name="ibus-hangul"/>
		<ignore name="ibus-anthy"/>
		<ignore name="ibus-table-chinese"/>
		<ignore name="ibus-table-chinese-cangjie"/>
		<ignore name="ibus-table"/> -->
		<!-- onlyRequired: the kde-desktop-environment collection no longer RECOMMENDS
		     the LibreOffice/Akonadi/ibus/VLC/podman consumer stack. Those consumers
	             hard-require bases that we ignore globally (libreoffice-data, akonadi-server,
	             ibus, vlc-libs, podman), so recommending them produced unsatisfiable
	             dependencies and broke the build. Only the explicitly-listed KDE Gear
	             apps above remain, keeping the live ISO under GitHub's 2 GB cap. -->
		<!-- Plasma Welcome app is optional for a live ISO; drop it to help keep
		     the ISO under GitHub's 2 GB release cap (fix #24 / PR #27). Reinstallable
		     later via `dnf install plasma-welcome-fedora`. -->
		<ignore name="plasma-welcome-fedora"/>
		<!-- <package name="plasma-welcome-fedora"/> -->
		<!-- Cut the Fedora Workstation/Desktop weak-dependency stack that
		     DesktopCommon (@plusRecommended) and LiveInstall pull in for the
		     KDE spin, so the live ISO stays under GitHub's 2 GB cap. In KIWI a
		     <ignore> is global — it removes the package from the whole
		     transaction regardless of which profile drags it in (Recommends:
		     or otherwise), so listing these here trims them everywhere yet
	             keeps firefox, mesa-vulkan-drivers and llama-cpp intact. Sizes are
	             approximate uncompressed MB from the build's top-30 report. -->
		<ignore name="libreoffice"/>
		<ignore name="libreoffice-core"/>              <!-- 289.1 MB -->
		<!--<ignore name="libreoffice-data"/> -->
		<!--<ignore name="libreoffice-help-en"/> -->           <!-- 51.2 MB -->
		<!--<ignore name="java-25-openjdk-headless"/> -->      <!-- 237.0 MB (pulled by libreoffice) -->
		<!--<ignore name="glibc-all-langpacks"/> -->           <!-- 227.2 MB (en_US + glibc-minimal-langpack remain) -->
		<!--<ignore name="ibus"/> -->                          <!-- 147.4 MB (Wayland virtual keyboard / fcitx5 if installed later) -->
		<!--<ignore name="python3-botocore"/>-->              <!-- 119.9 MB (AWS SDK from anaconda cloud plugins) -->
		<!--<ignore name="cldr-emoji-annotation"/> -->         <!-- 119.0 MB -->
		<!--<ignore name="nvidia-gpu-firmware"/> -->           <!-- 101.0 MB -->
		<!--<ignore name="mariadb-server"/> -->                <!-- 80.4 MB (akonadi embedded db) -->
		<!--<ignore name="mariadb-common"/> -->
		<!--<ignore name="akonadi-server"/> -->
		<!-- NOTE: google-noto-*-cjk-vf-fonts intentionally NOT ignored here because they
		            are hard-required by the base default-fonts-cjk-* packages (errors 14/15
		            during the build). Kept so the transaction stays satisfiable. -->
		<!--<ignore name="podman"/> -->                        <!-- 52.7 MB -->
		<ignore name="firefox"/>
		<!--<ignore name="firefox-langpacks"/> -->             <!-- 48.8 MB (English Firefox works without extras) -->
		<!--<ignore name="vlc-libs"/> -->                      <!-- 43.3 MB -->
		<ignore name="plasma-workspace-wallpapers"/> <!-- 294.8 MB -->
	</packages>
</image>
