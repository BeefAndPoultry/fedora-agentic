<image>
	<profiles>
		<profile name="DesktopCommon" description="Common desktop packages">
			<requires profile="BaseCommon"/>
			<requires profile="HardwareCommon"/>
		</profile>
	</profiles>
	<packages type="image" patternType="onlyRequired" profiles="DesktopCommon">
		<!-- onlyRequired: stop pulling the full Workstation/Desktop weak-dependency
		     stack (libreoffice-core, java-25-openjdk-headless, mariadb-server, podman,
		     etc.) that plusRecommended adds to every desktop's named collections.
		     Keeps the live ISO under GitHub's 2 GB cap; those deps are optional and
		     reinstallable via dnf later. -->
		<namedCollection name="fonts"/>
		<!-- <namedCollection name="multimedia"/> -->
		<namedCollection name="networkmanager-submodules"/>
		<namedCollection name="printing"/>
		<namedCollection name="guest-desktop-agents"/>
		<package name="mediawriter"/>
		<ignore name="gfs2-utils"/>
		<ignore name="reiserfs-utils"/>
	</packages>
</image>
